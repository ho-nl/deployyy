#!/bin/sh
# Laravel's scheduler: each entry of DEPLOYYY_SCHEDULE, a JSON list of
# {"every", "command"}, under supercronic from the application root. Without
# entries, Laravel's own loop: php artisan schedule:work.
set -e
entries=$(php -r 'foreach (json_decode(getenv("DEPLOYYY_SCHEDULE") ?: "[]", true) ?: [] as $e) { echo trim($e["every"]), " cd /var/www/html && ", trim($e["command"]), "\n"; }')
if [ -z "$entries" ]; then
  exec php artisan schedule:work
fi
printf '%s\n' "$entries" >/tmp/crontab
exec supercronic -passthrough-logs /tmp/crontab

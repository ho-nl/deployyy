#!/bin/sh
# sendmail_path shim: relay PHP mail to Mailpit over SMTP (target: MP_SENDMAIL_SMTP_ADDR).
#
# With MP_SENDMAIL_SMTP_ADDR set (an environment with the project's Mailpit), an `X-Tags`
# header with DEPLOYYY_BRANCH_URL is prepended so the project's SHARED Mailpit tags every
# message with the environment it came from (filter with tag:<branch host> in the UI).
# Mailpit tags on X-Tags by default; header order is free per RFC 5322, so prepending is
# safe: stdin here is a plain header+body message from PHP mail(), never an SMTP
# conversation.
#
# Without MP_SENDMAIL_SMTP_ADDR this is a transparent pass-through, so the tag header
# never leaks into mail from tiers that send real mail.
if [ -n "$MP_SENDMAIL_SMTP_ADDR" ] && [ -n "$DEPLOYYY_BRANCH_URL" ]; then
  { printf 'X-Tags: %s\n' "$DEPLOYYY_BRANCH_URL"; cat; } | /usr/local/bin/mailpit sendmail "$@"
else
  exec /usr/local/bin/mailpit sendmail "$@"
fi

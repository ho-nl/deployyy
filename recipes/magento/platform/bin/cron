#!/bin/sh
# Magento's cron: cron:run every minute, then the crontab lines of the
# variable CRONTAB. Output goes to the process log.
set -e
mkdir -p /var/www/html/var/log
{
  echo '* * * * * php /var/www/html/bin/magento cron:run 2>&1'
  if [ -n "${CRONTAB:-}" ]; then
    printf '%s\n' "$CRONTAB"
  fi
} >/tmp/crontab
exec supercronic /tmp/crontab

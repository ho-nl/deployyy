#!/bin/sh
# sendmail_path of PHP: relays mail() to the mail catcher of the platform over SMTP.
#
# Below production the platform sets MAILCATCHER_SMTP_HOST and MAILCATCHER_SMTP_PORT.
# The relay prepends an `X-Tags` header with DEPLOYYY_BRANCH_URL, so the mail catcher
# tags each message with its environment. stdin is a plain message from mail(), so the
# order of the headers is free (RFC 5322).
#
# Production has no mail catcher: the relay passes the message through without the tag.
if [ -n "$MAILCATCHER_SMTP_HOST" ] && [ -n "$MAILCATCHER_SMTP_PORT" ]; then
  export MP_SENDMAIL_SMTP_ADDR="$MAILCATCHER_SMTP_HOST:$MAILCATCHER_SMTP_PORT"
fi
if [ -n "$MP_SENDMAIL_SMTP_ADDR" ] && [ -n "$DEPLOYYY_BRANCH_URL" ]; then
  { printf 'X-Tags: %s\n' "$DEPLOYYY_BRANCH_URL"; cat; } | /usr/local/bin/mailpit sendmail "$@"
else
  exec /usr/local/bin/mailpit sendmail "$@"
fi
